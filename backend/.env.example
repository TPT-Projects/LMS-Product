# Copy to backend/.env and fill in. Never commit .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Encrypts Meta tokens at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# used to build invite and reset-password links
FRONTEND_URL=http://localhost:5173
# Public address of the API (the Facebook login popup returns here)
BACKEND_URL=http://localhost:8000

# PostgreSQL (app role, NOT the superuser; see docker/postgres)
POSTGRES_DB=lms
POSTGRES_USER=lms_app
POSTGRES_PASSWORD=lms_app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lms

# Redis / Celery / Channels
# Empty REDIS_URL = no Redis: background jobs run inline, live updates stay in one process.
REDIS_URL=redis://localhost:6379/0

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Meta (Phase 4)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Facebook returns the login popup to the API. Default: <BACKEND_URL>/api/meta/callback/
# Add exactly this address under Facebook Login > Settings > Valid OAuth Redirect URIs.
# WhatsApp guided signup: Facebook Login for Business > Configurations > WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=
META_OAUTH_REDIRECT_URI=

# Storage, S3-compatible (Phase 1+)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Email (empty EMAIL_HOST = emails are printed to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LMS <no-reply@localhost>

# Monitoring (Phase 6)
SENTRY_DSN=

# Google Sheets app (console.cloud.google.com > Credentials > OAuth client ID, Web application).
# Authorised redirect URI: <BACKEND_URL>/api/integrations/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
